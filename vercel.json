{
  "version": 2,
  "builds": [
    {
      "src": "mcp-server/src/server_app.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.9" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "mcp-server/src/server_app.py" },
    { "src": "/(.*)", "dest": "mcp-server/src/server_app.py" }
  ]
}